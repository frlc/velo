# Copie para `.env` e preencha um ambiente por vez (não repita as mesmas chaves no mesmo arquivo).
# Preview — desenvolvimento local e alinhado ao deploy preview na Vercel
VITE_SUPABASE_PROJECT_ID="seu_project_ref_preview"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_ou_anon_preview"
VITE_SUPABASE_URL="https://seu_project_ref_preview.supabase.co"

# Connection string do pooler (Database → Connection string) — use no Playwright / Kysely
DATABASE_URL="postgresql://postgres.seu_project_ref_preview:SENHA@aws-0-regiao.pooler.supabase.com:5432/postgres"

# Opcional: força o banco dos E2E mesmo se DATABASE_URL existir (recomendado em CI via GitHub Secret)
# E2E_DATABASE_URL="postgresql://..."

# --- Produção (manter em `.env.production` separado ou só na Vercel → Environment → Production) ---
# VITE_SUPABASE_PROJECT_ID="seu_project_ref_producao"
# VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_ou_anon_producao"
# VITE_SUPABASE_URL="https://seu_project_ref_producao.supabase.co"
# DATABASE_URL="postgresql://postgres.seu_project_ref_producao:...@...pooler.supabase.com:5432/postgres"
